QPushButton {
        color: %PRIMARY%;
        background-color: %CELL_COLOR%;
        border-top: %BORDER_TOP%px solid %PRIMARY%;
        border-right: %BORDER_RIGHT%px solid %PRIMARY%;
        border-bottom: %BORDER_BOTTOM%px solid %PRIMARY%;
        border-left: %BORDER_LEFT%px solid %PRIMARY%;
        border-top-left-radius: %CORNER_RADIUS_TL%px;
        border-top-right-radius: %CORNER_RADIUS_TR%px;
        border-bottom-right-radius: %CORNER_RADIUS_BR%px;
        border-bottom-left-radius: %CORNER_RADIUS_BL%px;
}

QPushButton:disabled {
        color: %TEXT_COLOR%;
        border-top: %BORDER_TOP_DISABLED%px solid %PRIMARY%;
        border-right: %BORDER_RIGHT_DISABLED%px solid %PRIMARY%;
        border-bottom: %BORDER_BOTTOM_DISABLED%px solid %PRIMARY%;
        border-left: %BORDER_LEFT_DISABLED%px solid %PRIMARY%;
}

